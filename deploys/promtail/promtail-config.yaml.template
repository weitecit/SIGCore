server:
  http_listen_port: 9080
  grpc_listen_port: 0

positions:
  filename: /shared-logs/positions.yaml

clients:
  - url: ${LOKI_URL}

scrape_configs:
  - job_name: stdout
    static_configs:
      - targets:
          - localhost
        labels:
          job: sigcore-${ENVIRONMENT}
          service_name: sigcore-${ENVIRONMENT}
          __path__: /shared-logs/app.log

